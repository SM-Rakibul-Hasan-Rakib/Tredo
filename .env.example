# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET! never share, never put NEXT_PUBLIC_ in front
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Your shop contact (shown on website)
NEXT_PUBLIC_SHOP_NAME=TREDO
NEXT_PUBLIC_MESSENGER_URL=https://m.me/yourpage
NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX
NEXT_PUBLIC_PHONE=01XXXXXXXXX
# Optional: separate admin link (Vercel → Settings → Domains e add kora domain)
# ADMIN_HOST=tredo-admin.vercel.app

# Admin session timer (server-enforced)
ADMIN_IDLE_TIMEOUT_MINUTES=15
ADMIN_MAX_SESSION_HOURS=8
# Optional: separate secret for admin session cookies (any long random text). If empty, derived from SUPABASE_SERVICE_ROLE_KEY.
# ADMIN_SESSION_SECRET=
